# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets for deployment.
# Streamlit exposes these as normal environment variables, so
# dhan_service.py picks them up the same way it reads .env locally.

DHAN_CLIENT_ID = "your_client_id"
DHAN_ACCESS_TOKEN = "your_access_token"
